# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Secret para firmar tokens JWT — cambiar en producción
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Servidor
HOST=127.0.0.1
PORT=3000

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug

# [303A-2] CORS: orígenes permitidos separados por coma. Si no se define, permite todo (dev)
# CORS_ORIGINS=http://restaurante.wandori.us

# [303A-2] Modo demo: habilita endpoints /api/admin/seed y /api/admin/reset
# DEMO_MODE=true

# URL pública del frontend (para enlaces en emails de recuperación)
# APP_URL=http://localhost:5173

# SMTP del servidor (para emails de reset de password y reportes de errores)
# Las credenciales de marketing (SMTP, Twilio, Meta) se configuran por usuario
# desde la interfaz web: Configuración > Integraciones.
# [065A-5] Meta tambien admite fallback desde env si la fila del usuario no tiene esos campos.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu-app-password
# SMTP_FROM_EMAIL=noreply@restaurante.com
# SMTP_FROM_NAME=Restaurante
# META_WABA_ID=1330208045872639
# META_BUSINESS_APP_ID=2109664896264441
# META_PHONE_NUMBER_ID=1023208230887075
# META_ACCESS_TOKEN=tu-token-meta
# META_WHATSAPP_NUMBER=+15556460107

# Email para reportes de errores del sistema
# ERROR_REPORT_EMAIL=admin@restaurante.com

# BDP WebLink REST API (punto de venta)
# Obtener credenciales del proveedor BDP o del restaurante.
# El BDP debe estar encendido y accesible desde la red del servidor.
BDP_BASE_URL=http://IP_DEL_BDP:8068
BDP_LOGIN=admin
BDP_PASSWORD=
BDP_INTEGRATOR_CODE=
BDP_POS_ID=1
BDP_EMPLOYEE_ID=1
BDP_ITEMS_PROFILE_ID=1
BDP_DEFAULT_ARTICLE_CODE=1001
BDP_DEFAULT_ARTICLE_NAME=Servicio

# [197A-3] Aprovisionamiento inicial dirigido. Si no se define el email,
# Glory no copia ninguna variable BDP a cuentas de usuario. Al activarlo,
# aplica una sola vez, conserva valores ya confirmados y deja solo lectura.
# BDP_BOOTSTRAP_USER_EMAIL=cuenta-exacta-del-restaurante@example.com
BDP_TENDER_MAP_JSON={}
BDP_ORDER_TYPE_MAP_JSON={}
BDP_DEFAULT_CUSTOMER_CODE=
BDP_POLL_INTERVAL_SECS=60

# Orígenes donde se permiten escrituras reales. Mantener vacío hasta que el
# destino productivo haya sido verificado y aprobado expresamente.
BDP_WRITE_ALLOWED_ORIGINS=
BDP_CHECK_ORDER_ALLOWED_ORIGINS=
